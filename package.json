    "uninstall:mac": "./scripts/uninstall-launch-agent.sh",
    "install:linux": "./scripts/install-systemd-user.sh",
    "uninstall:linux": "./scripts/uninstall-systemd-user.sh"
  },
  "bin": {
    "phone-charge-guardian": "bin/phone-charge-guardian.js"
  },
  "engines": {
    "node": ">=20"
  },
