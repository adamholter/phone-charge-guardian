{
  "name": "phone-charge-guardian",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Tiny cross-platform local watcher for flaky wired phone USB/charging connections.",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
